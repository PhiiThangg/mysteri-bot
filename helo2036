            const targetUserId = parts[2];
            const requesterId = parts[3];

            if (interaction.user.id !== targetUserId) {
                return interaction.reply({
                    content: "❌ Bạn không phải là người được yêu cầu xem avatar nên không thể bấm nút này!",
